\name{mean_squared_error}
\alias{mean_squared_error}
\title{Mean squared error}
\usage{mean_squared_error(actual, predicted)}
\arguments{
  \item{actual}{Observed responses.}
  \item{predicted}{Predicted responses.}
}
\description{Compute the mean squared difference between observations and predictions.}
\value{The average squared prediction error.}
