          },
          {
            "type": "text",
            "value": "installs the executable in Cargo's binary directory, normally ",
            "span": {
              "start": 266,
              "end": 328
            }
          },
          {
            "type": "code",
            "value": "~/.cargo/bin",
            "span": {
              "start": 328,
              "end": 342
            }
          },
          {
            "type": "text",
            "value": ".",
            "span": {
