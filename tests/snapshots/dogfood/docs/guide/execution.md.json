          },
          {
            "type": "soft-break",
            "span": {
              "start": 1318,
              "end": 1319
            }
          },
          {
            "type": "text",
            "value": "stdout, stderr, and tracebacks remain text. Supported images become local",
            "span": {
              "start": 1319,
              "end": 1392
            }
          },
          {
            "type": "soft-break",
            "span": {
              "start": 1392,
              "end": 1393
            }
          },
          {
            "type": "text",
            "value": "assets; unsafe HTML or SVG is rejected. A page cache can reuse a successful",
            "span": {
