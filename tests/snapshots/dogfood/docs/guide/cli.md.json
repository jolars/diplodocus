          },
          {
            "type": "soft-break",
            "span": {
              "start": 2339,
              "end": 2340
            }
          },
          {
            "type": "text",
            "value": "each have a 5-second limit. The library accepts explicit ",
            "span": {
              "start": 2340,
              "end": 2397
            }
          },
          {
            "type": "code",
            "value": "ExecutionDeadlines",
            "span": {
